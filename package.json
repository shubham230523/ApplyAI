{
  "name": "applyai-monorepo",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "client:start": "npm run start --workspace=apps/client",
    "client:android": "npm run android --workspace=apps/client",
    "client:ios": "npm run ios --workspace=apps/client",
    "client:web": "npm run web --workspace=apps/client",
    "client:lint": "npm run lint --workspace=apps/client"
  },
  "devDependencies": {
    "babel-plugin-module-resolver": "^5.0.3",
    "nativewind": "^4.2.6",
    "tailwindcss": "^3.4.17"
  }
}
